# Copy this file to .env and fill in your own values. Never commit .env.

# LLM provider (Anthropic API). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model used by the agents.
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max (higher = slower, costlier).
ANTHROPIC_EFFORT=medium

# PostgreSQL connection for run records. Leave empty to skip recording.
# Matches the db service in docker-compose.yml (start it with: docker compose up -d db).
DATABASE_URL=postgresql://swe_agent:swe_agent@localhost:5433/swe_agent

# Docker sandbox settings for running tests.
# Built automatically from docker/sandbox.Dockerfile on first use.
SANDBOX_IMAGE=swe-agent-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0

# How many times to retry after a failed patch (spec: up to 2).
MAX_PATCH_RETRIES=2
